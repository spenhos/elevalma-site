---
layout: null
---
{
  "totalPosts": {{ site.posts | size }},
  "firstPostDate": "{{ site.posts | last | map: 'date' | date: '%Y-%m-%d' }}",
  "lastPostDate": "{{ site.posts | first | map: 'date' | date: '%Y-%m-%d' }}",
  "updatedAt": "{{ site.time | date_to_xmlschema }}",
  "categories": [{% assign cats = site.categories %}{% for cat in cats %}{"name":"{{ cat[0] }}","count":{{ cat[1] | size }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "tags": [{% assign sorted_tags = site.tags | sort %}{% for tag in sorted_tags %}{"name":"{{ tag[0] }}","count":{{ tag[1] | size }}}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "postsByMonth": [{% assign months_seen = "" %}{% for post in site.posts %}{% assign m = post.date | date: "%Y-%m" %}{% unless months_seen contains m %}{% if months_seen != "" %},{% endif %}{"month":"{{ m }}","count":{% assign count = 0 %}{% for p in site.posts %}{% assign pm = p.date | date: "%Y-%m" %}{% if pm == m %}{% assign count = count | plus: 1 %}{% endif %}{% endfor %}{{ count }}}{% assign months_seen = months_seen | append: "," | append: m %}{% endunless %}{% endfor %}],
  "recentPosts": [{% for post in site.posts limit:10 %}{"title":"{{ post.title | escape }}","date":"{{ post.date | date: '%Y-%m-%d' }}","url":"{{ post.url }}","readTime":{{ post.content | number_of_words | divided_by: 200 | plus: 1 }}{% if post.categories.size > 0 %},"category":"{{ post.categories | first }}"{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
}
